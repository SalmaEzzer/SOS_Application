# Copie en .env et remplace cette valeur sur ta machine.
# Valeur de remplacement uniquement : aucun secret réel n'est fourni.
POSTGRES_DB=sos
POSTGRES_USER=sos_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Facultatif : les réglages par défaut relient le backend à localhost:5432.
# DB_URL=jdbc:postgresql://localhost:5432/sos
# DB_USERNAME=sos_app
# DB_PASSWORD=replace-with-a-local-password
SERVER_PORT=8080
SOS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
